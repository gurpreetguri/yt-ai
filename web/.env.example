# Base URL of the NestJS backend, if/when POST /api/pipeline/run exists there.
# Leave empty to call a relative /api/pipeline/run path (e.g. behind a proxy/rewrite).
# If the endpoint is missing or unreachable, the UI automatically falls back
# to a local mocked simulation of the 8-agent pipeline (lib/mock-data.ts) —
# no backend is required to use this tool.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
