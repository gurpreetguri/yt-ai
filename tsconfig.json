{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "lib": ["ES2021"],
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "incremental": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": {
      "@agents/agent-00-strategy/*": ["agents/agent-00-strategy/*"],
      "@agents/agent-01-topic-discovery/*": ["agents/agent-01-topic-discovery/*"],
      "@agents/agent-02-research/*": ["agents/agent-02-research/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "agents/agent-00-strategy/**/*.ts",
    "agents/agent-01-topic-discovery/**/*.ts",
    "agents/agent-02-research/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "agents/agent-00-strategy/**/*.spec.ts",
    "agents/agent-01-topic-discovery/**/*.spec.ts",
    "agents/agent-02-research/**/*.spec.ts"
  ]
}
