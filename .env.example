# AI provider selection for AGT-00 Strategy Agent runtime.
# "anthropic" calls the real Anthropic Messages API; "mock" (default) never
# calls a network and always returns a structured refusal — safe for local
# development and CI without a credential.
AI_PROVIDER=mock

# Required when AI_PROVIDER=anthropic. Never commit a real value.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Hard ceiling (milliseconds) on a single AI provider invocation.
AI_TIMEOUT_MS=45000

# Matches the prompt's declared max output tokens (system-prompt.md).
AI_MAX_OUTPUT_TOKENS=8000

# HTTP port for the NestJS application.
PORT=3000
