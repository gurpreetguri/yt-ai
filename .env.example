# AI provider selection. "mock" (default) never calls a network and always
# returns a structured refusal — safe for local development and CI without
# any credential. "anthropic" binds directly to the Anthropic Messages API.
# "router" enables the Multi-LLM router (`ModelRouterProvider`), which
# selects among every registered, enabled, policy-allowed model at
# invocation time instead of a single fixed adapter.
#
# To run the pipeline against a local Ollama + DeepSeek-Coder install (no
# cloud credential needed): set AI_PROVIDER=router, AI_ROUTER_MODE=local,
# make sure Ollama is running with `ollama pull deepseek-coder:6.7b`, and
# leave OLLAMA_MODEL at its default below.
AI_PROVIDER=mock

# ---------------------------------------------------------------------------
# Multi-LLM router policy (only used when AI_PROVIDER=router)
# ---------------------------------------------------------------------------

# Router mode controls which class of model the router is allowed to pick:
#   auto  - honours AI_ALLOW_LOCAL / AI_ALLOW_FREE / AI_ALLOW_PAID below
#   local - local models only (e.g. Ollama), ignores the AI_ALLOW_* flags
#   free  - local models plus providers explicitly listed in
#           AI_FREE_PROVIDERS, ignores the AI_ALLOW_* flags
#   paid  - paid cloud providers only, ignores the AI_ALLOW_* flags
AI_ROUTER_MODE=auto

# Local/free/paid policy flags. Only consulted when AI_ROUTER_MODE=auto; each
# mode above other than "auto" fixes these implicitly. A provider is never
# assumed free — see AI_FREE_PROVIDERS.
AI_ALLOW_LOCAL=true
AI_ALLOW_FREE=true
AI_ALLOW_PAID=true

# Whether the router may fail over to the next ranked candidate on a
# transient error (RATE_LIMIT, QUOTA_EXHAUSTED, TIMEOUT, NETWORK,
# PROVIDER_ERROR). AUTH/CONFIGURATION/INVALID_RESPONSE never fail over,
# regardless of this flag, since retrying those against a different model
# would not fix the underlying problem.
AI_FALLBACK_ENABLED=true

# Advisory only: informs bootstrap provider registration priority. Does not
# itself force model selection. Leave empty to have no preferred provider.
AI_PRIMARY_PROVIDER=

# Default quality tier used to rank candidates when a request does not
# specify its own capability/quality requirements. One of:
# LOW | BALANCED | HIGH | MAX.
AI_DEFAULT_QUALITY=BALANCED

# Cooldown (milliseconds) applied to a provider after it reports RATE_LIMIT
# and does not itself report a retry-after duration. When a provider adapter
# does report one, that reported value is honoured instead of this default.
AI_RATE_LIMIT_COOLDOWN_MS=30000

# Cooldown (milliseconds) applied to a provider after it reports
# QUOTA_EXHAUSTED. Quota resets are not typically reported per-request, so
# this configured window is always used.
AI_QUOTA_COOLDOWN_MS=3600000

# Comma-separated list of provider names (e.g. "groq,openrouter") to treat
# as FREE cloud providers for AI_ROUTER_MODE=free / AI_ALLOW_FREE policy
# matching. A cloud provider absent from this list is treated as PAID.
# Local providers (e.g. Ollama) are always free by inherent fact and do not
# need to be listed here.
AI_FREE_PROVIDERS=

# ---------------------------------------------------------------------------
# Provider credentials and model overrides
# ---------------------------------------------------------------------------
# Never commit real credentials to this file or to a real .env in version
# control. Leave a provider's API key empty to leave that provider disabled.
#
# Each provider also accepts an optional *_MODEL_QUALITY override (one of
# LOW | BALANCED | HIGH | MAX, default BALANCED). This is an operator
# DECLARATION used only to break ties when ranking router candidates against
# AI_DEFAULT_QUALITY — never a vendor-claimed benchmark fact, and never
# invented by this codebase.

# Anthropic (Claude). Required when AI_PROVIDER=anthropic, or to enable
# Anthropic as a router candidate when AI_PROVIDER=router.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL_QUALITY=BALANCED

# OpenAI. Registered in the router's model registry as a disabled
# placeholder only — no adapter is implemented yet, so this credential has
# no effect until an OpenAI adapter exists.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_QUALITY=BALANCED

# Google Gemini. Registered as a disabled placeholder only — no adapter is
# implemented yet.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
GEMINI_MODEL_QUALITY=BALANCED

# OpenRouter. Registered as a disabled placeholder only — no adapter is
# implemented yet.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_MODEL_QUALITY=BALANCED

# Groq. Registered as a disabled placeholder only — no adapter is
# implemented yet.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL_QUALITY=BALANCED

# Ollama (local). No API key required — it is a local HTTP server. Set
# OLLAMA_MODEL to whatever model you have pulled locally (`ollama pull ...`).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=mistral:latest
OLLAMA_MODEL_QUALITY=BALANCED

# ---------------------------------------------------------------------------
# Invocation limits (apply to every provider)
# ---------------------------------------------------------------------------

# Hard ceiling (milliseconds) on a single AI provider invocation.
AI_TIMEOUT_MS=45000

# Matches each agent prompt's declared max output tokens (system-prompt.md).
AI_MAX_OUTPUT_TOKENS=8000

# HTTP port for the NestJS application.
PORT=3000

# Comma-separated allowlist of origins permitted to call this API
# cross-origin (e.g. the observability UI running on its own port).
# Never a wildcard. Defaults to http://localhost:3001 if unset.
CORS_ORIGIN=http://localhost:3001
