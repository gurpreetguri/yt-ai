{
  "name": "ytv",
  "version": "0.1.0",
  "description": "AI YouTube Automation Platform — NestJS runtime, starting with AGT-00 Strategy Agent.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && node scripts/copy-prompt-asset.js",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "testEnvironment": "node",
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.[jt]sx?$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^@agents/agent-00-strategy/(.*)$": "<rootDir>/agents/agent-00-strategy/$1",
      "^@agents/agent-01-topic-discovery/(.*)$": "<rootDir>/agents/agent-01-topic-discovery/$1",
      "^@agents/agent-02-research/(.*)$": "<rootDir>/agents/agent-02-research/$1",
      "^@agents/agent-03-fact-verification/(.*)$": "<rootDir>/agents/agent-03-fact-verification/$1",
      "^@agents/agent-04-story-architect/(.*)$": "<rootDir>/agents/agent-04-story-architect/$1",
      "^@agents/agent-05-script-writer/(.*)$": "<rootDir>/agents/agent-05-script-writer/$1",
      "^@agents/agent-06-script-reviewer/(.*)$": "<rootDir>/agents/agent-06-script-reviewer/$1"
    },
    "collectCoverageFrom": ["src/**/*.(t|j)s"],
    "coverageDirectory": "./coverage"
  }
}
